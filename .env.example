# ═══════════════════════════════════════════════════════════════════════
# Mizo Universe — Environment Variables
# ═══════════════════════════════════════════════════════════════════════

# ─── Sanity CMS ────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_write_token

# ─── AI APIs (at least one required for blog generation) ───────────────
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AIza...

# ─── Admin Authentication ──────────────────────────────────────────────
# Token for /secret-control-room and /api/generate-blog
# In dev mode, if not set, these routes are accessible without auth.
MIZO_ADMIN_TOKEN=your_secret_admin_token

# ─── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mizoamin.com

# ─── Google Analytics 4 ───────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Google Indexing API (Instant URL Submission) ──────────────────────
# Service Account from Google Cloud Console with Indexing API enabled
GOOGLE_INDEXING_CLIENT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_INDEXING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Sanity Webhook (triggers Google Indexing on publish) ──────────────
SANITY_WEBHOOK_SECRET=your_webhook_secret
