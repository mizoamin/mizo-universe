{
    "name": "mizoamin/mizo-universe-mcp",
    "description": "PHP MCP server with attribute-based discovery for the Mizo Universe ecosystem",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "mcp/sdk": "^0.4",
        "symfony/cache": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php server.php"
    }
}
